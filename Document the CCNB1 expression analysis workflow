        "# Run this first. It downloads your data and sets up the self-checks.\n",
        "import hashlib\n",
        "import json\n",
        "import urllib.request\n",
        "from pathlib import Path\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from scipy.stats import mannwhitneyu\n",
        "\n",
        "DATA_URL = \"https://raw.githubusercontent.com/HocheggerLab/tcga-capstone-2026/main/data/\"\n",
        "\n",
        "def fetch(filename):\n",
        "    \"\"\"Return a local data path, downloading it in Colab if needed.\"\"\"\n",
        "    repo_path = Path(\"data\") / filename\n",
        "    working_path = Path(filename)\n",
        "\n",
        "    if repo_path.exists():                   # running from the repo\n",
        "        return repo_path\n",
        "    if not working_path.exists():            # running in Colab\n",
        "        urllib.request.urlretrieve(DATA_URL + filename, working_path)\n",
        "    return working_path\n",
        "\n",
        "\n",
        "def my_variant(student_id):\n",
        "    \"\"\"Look up your gene and cancer type from your Sussex username.\"\"\"\n",
        "    number = str(student_id).strip().lower()\n",
        "    if not number:\n",
        "        raise ValueError(\"Type your Sussex username into \"\n",
        "                         \"STUDENT_ID, then run this cell again.\")\n",
        "    key = hashlib.pbkdf2_hmac(\"sha256\", number.encode(), b'tcga-capstone-2026',\n",
        "                              2_000_000).hex()[:16]\n",
        "    lookup = json.loads(Path(fetch(\"variant_lookup.json\")).read_text())\n",
        "    if key not in lookup:\n",
        "        raise ValueError(f\"{number} is not on the class list. Check it \"\n",
        "                         \"against Canvas; if it is right, email the convenor.\")\n",
        "    gene, cancer_type = lookup[key]\n",
        "    print(f\"{number}: your gene is {gene}, your cancer type is {cancer_type}\")\n",
        "    return gene, cancer_type\n",
        "\n",
        "\n",
        "def run_checks(checks):\n",
        "    \"\"\"Run a dict of {description: test} and report what passed.\n",
        "\n",
        "    Each test is a zero-argument function returning True or False. A\n",
        "    test that raises is reported rather than stopping the notebook, so\n",
        "    you always see the full picture.\n",
        "    \"\"\"\n",
        "    passed = 0\n",
        "    for description, test in checks.items():\n",
        "        try:\n",
        "            ok = bool(test())\n",
        "        except Exception as exc:\n",
        "            print(f\"\\u274c {description}\")\n",
        "            print(f\"     raised {type(exc).__name__}: {exc}\")\n",
        "            continue\n",
        "        print(f\"{'\\u2705' if ok else '\\u274c'} {description}\")\n",
        "        passed += ok\n",
        "    print()\n",
        "    print(f\"{passed} of {len(checks)} checks passed\")\n",
        "    if passed < len(checks):\n",
        "        print(\"Keep going - fix the crosses and run this cell again.\")\n",
        "\n",
        "\n",
        "STUDENT_ID = \"wk202\"   # <-- your Sussex username, e.g. \"ab123\"\n",
        "\n",
        "GENE, CANCER_TYPE = my_variant(STUDENT_ID)\n",
        "\n",
        "MY_EXPRESSION = fetch(f\"expression_{GENE}_{CANCER_TYPE}.csv\")\n",
        "EXAMPLE_EXPRESSION = fetch(\"expression_example.csv\")\n",
        "\n",
        "expr = pd.read_csv(MY_EXPRESSION)\n",
