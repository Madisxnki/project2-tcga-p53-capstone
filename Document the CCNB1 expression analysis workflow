      "outputs": [],
      "source": [
        "def plot_comparison(expr, gene, cancer_type):\n",
        "    \"\"\"Plot expression in normal, TP53 wild-type and mutant samples.\n",
        "\n",
        "    Show each group's distribution as a boxplot with its individual\n",
        "    sample values overlaid, so the spread and sample-level data remain\n",
        "    visible in a single figure.\n",
        "    \"\"\"\n",
        "    # Restrict each group to the requested cancer type and exclude samples\n",
        "    # without an expression measurement.\n",
        "    normal = expr[\n",
        "        (expr[\"cancer_type\"] == cancer_type)\n",
        "        & (expr[\"group\"] == \"normal\")\n",
        "    ][\"log2_tpm\"].dropna()\n",
        "\n",
        "    wild_type = expr[\n",
        "        (expr[\"cancer_type\"] == cancer_type)\n",
        "        & (expr[\"group\"] == \"tumour\")\n",
        "        & (expr[\"tp53_status\"] == \"WT\")\n",
        "    ][\"log2_tpm\"].dropna()\n",
        "\n",
        "    mutant = expr[\n",
        "        (expr[\"cancer_type\"] == cancer_type)\n",
        "        & (expr[\"group\"] == \"tumour\")\n",
        "        & (expr[\"tp53_status\"] == \"MUT\")\n",
        "    ][\"log2_tpm\"].dropna()\n",
        "\n",
        "    # Keep the groups in the order needed to read the comparison:\n",
        "    # normal tissue, wild-type tumours, then TP53-mutant tumours.\n",
        "    groups = [normal, wild_type, mutant]\n",
        "    labels = [\n",
        "    f\"Normal\\n(n={len(normal)})\",\n",
        "    f\"TP53 wild-type\\n(n={len(wild_type)})\",\n",
        "    f\"TP53 mutant\\n(n={len(mutant)})\",\n",
        "    ]\n",
        "\n",
        "    # Create one panel and size it to accommodate the three group labels.\n",
        "    fig, ax = plt.subplots()\n",
        "    fig.set_size_inches(8, 5)\n",
        "\n",
        "    # Show the boxplot summaries; the individual points are added below,\n",
        "    # so suppressing the fliers avoids plotting those values twice.\n",
        "    ax.boxplot(groups, tick_labels=labels, showfliers=False)\n",
        "\n",
        "    # Jitter points slightly along the x-axis so overlapping samples\n",
        "    # remain visible; their expression values on the y-axis are unchanged.\n",
        "    for i, values in enumerate(groups, start=1):\n",
        "        x = np.random.normal(i, 0.06, len(values))\n",
        "        ax.scatter(x, values, s=8, alpha=0.5)\n",
        "\n",
        "    # State the expression scale and identify the gene and cancer type.\n",
        "    ax.set_ylabel(\"Expression: log2(TPM + 0.001)\")\n",
        "    ax.set_title(f\"{gene} expression in {cancer_type}\")\n",
        "    fig.tight_layout()\n",
        "\n",
        "    return fig\n",
        "    raise NotImplementedError(\"plot_comparison\")"
      ]
